(footprint "Molex_480994000_MiniPCIe_Latch"
	(version 20240108)
	(generator "pcbnew")
	(generator_version "8.0")
	(layer "F.Cu")
	(descr "Molex 48099-4000 latch for full-size Mini PCI Express card, snap-in, no solder. PCB layout per Molex SD-48099-400: 2x D2.60mm non-plated through holes at 24.20mm spacing, placed on the card hold-down line 48.05mm from the socket card-edge line (PCI Express Mini Card CEM spec r1.2 Fig 2-11). Engages the 51x30mm card's retention notches; 5.80x5.80mm component/routing keep-out (all layers) around each post per SD-67910-001 note 2")
	(tags "mini pcie latch hold-down molex 48099 full-size")

				)
			)
		)
		(property "Design Notes" "Isolates the GNSS VCC branch from the rest of 3V3_SYS. Selected on DC resistance, not impedance: Integration manual 4.2.1 forbids more than 0.2 Ohm of series resistance in the VCC line, and the same-impedance parts in the other BLM18 families miss it (BLM18AG601SN1D is 0.38 Ohm, BLM18HG601SN1D is 1.0 Ohm). BLM18KG601SZ1D (automotive-grade KG series) gives the full 600 Ohm at 100 MHz at 0.15 Ohm max initial DCR, 0.165 Ohm after testing - verify at order the SZ1 automotive suffix keeps the SN1D's DCR spec, since the 0.2 Ohm limit is the whole selection. This is the part called FB2 in the pre-KiCad docs."
			(at 0 0 0)
			(unlocked yes)
			(layer "F.Fab")
			(hide yes)
			(uuid "171ca083-21ee-4033-932b-790902cf387e")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)

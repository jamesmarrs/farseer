		(property "Description" "Nano-SIM (4FF) holder, hinged locking cover, 6 contacts + normally-open card-detect switch (SW closes to grounded shell when card seated)"
			(at 0 0 90)
			(layer "F.Fab")
			(hide yes)
			(uuid "4c46fc76-c39b-473a-a4a4-2a0d66cef231")

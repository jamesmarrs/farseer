		(property "Description" "Nano-SIM (4FF) holder, hinged locking cover, 6 contacts + normally-open card-detect switch (SW closes to grounded shell when card seated)"
			(at 241.3 90.17 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "MPN" "SIM8060-6-1-14-00-A"
			(at 241.3 90.17 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font

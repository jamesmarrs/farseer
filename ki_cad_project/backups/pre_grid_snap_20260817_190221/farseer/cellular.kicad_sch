				)
			)
		)
		(property "Manufacturer" "GCT"
			(at 241.3 90.17 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Design Notes" "Hinged type chosen for in-car vibration: stainless cover locks over the card (lock force >= 1.5 N, unlock <= 10 N; shock-tested 490 m/s2 and vibration-tested per GCT spec, 5000 cycles). Detect switch is normally open and closes SW to the grounded shell when the card is seated -> SIM_DET low = inserted; enable hot-plug with AT+QSIMDET=1,0 (disabled by default, saved to NV). User SIM is a Hologram Hyper triple-cut card punched to the nano (4FF) cut - 1.62-5.5 V, industrial grade. Layout (Quectel 3.3, all mandatory): holder close to the socket, trace < 200 mm; SIM lines away from RF and the buck A rail; GND between socket and holder short and wide (>= 0.5 mm); IO and CLK separated and shielded by ground; all protection parts at the holder."
			(at 241.3 90.17 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
